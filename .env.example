INLOCK_ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
INLOCK_SECRET_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-bytes
INLOCK_PUBLIC_URL=https://inlock.exemplo.com
INLOCK_ADMIN_HOST=inlock.exemplo.com
INLOCK_SECURE_COOKIES=true
INLOCK_TRUSTED_PROXIES=127.0.0.1/32,::1/128
INLOCK_ENFORCE_CONTAINER_ISOLATION=true
INLOCK_CONTAINER_RECONCILE_SECONDS=10
# Opcional: somente se o proxy confiável sobrescrever este header com JA3/JA4.
# INLOCK_TLS_FINGERPRINT_HEADER=X-Inlock-JA4
# INLOCK_GEOIP_CITY_DB=/data/GeoLite2-City.mmdb
